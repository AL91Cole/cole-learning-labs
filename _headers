/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), display-capture=(), usb=(), serial=(), hid=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Alternate deployment hosts must not become search results. This is an
# indexing preference, not access control for current or older deployments.
https://cole-learning-labs.pages.dev/*
  X-Robots-Tag: noindex

https://:version.cole-learning-labs.pages.dev/*
  X-Robots-Tag: noindex

# The offline worker must always revalidate so a new release is noticed; the manifest is small and public.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate, no-transform

/src/*
  Cache-Control: public, max-age=0, must-revalidate

# Route chunks carry a content hash in their name, so a changed route gets a new URL.
/src/chunks/*
  Cache-Control: public, max-age=31536000, immutable

/assets/cole-learning-labs-student-workbook.pdf
  Content-Type: application/pdf
  Content-Disposition: attachment; filename="cole-learning-labs-student-workbook.pdf"
  Cache-Control: private, no-store, no-transform

/assets/cole-learning-labs-pop-quizzes.pdf
  Content-Type: application/pdf
  Content-Disposition: attachment; filename="cole-learning-labs-pop-quizzes.pdf"
  Cache-Control: private, no-store, no-transform

/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/classroom
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/school-it
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/student-workbook
  Cache-Control: private, no-store, no-transform
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

