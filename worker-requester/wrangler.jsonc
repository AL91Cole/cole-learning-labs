{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cole-learning-labs-requester",
  "main": "worker.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "ai": { "binding": "AI" },
  "observability": {
    "enabled": false
  },
  "vars": {
    "REQUESTER_ENABLED": "true",
    "REQUESTER_BILLING_REVIEWED": "true"
  },
  "d1_databases": [{
    "binding": "REQUESTER_BUDGET",
    "database_name": "cole-learning-labs-requester-budget",
    "database_id": "a29b1ed2-0477-4c0f-8897-50823ba37e8d"
  }]
}
