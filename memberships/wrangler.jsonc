{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cole-learning-labs-memberships",
  "main": "dist/worker.mjs",
  "build": {"command":"npm run build","cwd":"."},
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "send_metrics": false,
  "upload_source_maps": false,
  "observability": {"enabled": false},
  "triggers": {"crons": []},
  "assets": {"directory":"./dist/public","binding":"MEMBERSHIP_PUBLIC_ASSETS","run_worker_first":true},
  "vars": {
    "MEMBERSHIP_ENABLED": "false",
    "MEMBERSHIP_PROCESSING_REVIEWED": "false",
    "MEMBERSHIP_DEPLOYMENT_MODE": "test"
  },
  "env": {
    "preview": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {"MEMBERSHIP_ENABLED":"false","MEMBERSHIP_PROCESSING_REVIEWED":"false","MEMBERSHIP_DEPLOYMENT_MODE":"test"}
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {"MEMBERSHIP_ENABLED":"false","MEMBERSHIP_PROCESSING_REVIEWED":"false","MEMBERSHIP_DEPLOYMENT_MODE":"test"}
    }
  }
}
