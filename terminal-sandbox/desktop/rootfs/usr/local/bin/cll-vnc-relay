#!/usr/bin/python3
"""Relays the screen between standard input/output and the local VNC server.

The host-container backend runs machines with no network at all, so the
controller reaches the screen through `docker exec -i <machine> cll-vnc-relay`
instead of a port: bytes from the controller go to 127.0.0.1:5900 and the
server's bytes come back on standard output.
"""
import os
import selectors
import socket
import sys
import time

deadline = time.monotonic() + 30
while True:
    try:
        server = socket.create_connection(("127.0.0.1", 5900), timeout=5)
        break
    except OSError:
        if time.monotonic() > deadline:
            sys.exit(1)
        time.sleep(0.2)
server.settimeout(None)
server.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)

stdin, stdout = sys.stdin.fileno(), sys.stdout.fileno()
selector = selectors.DefaultSelector()
selector.register(stdin, selectors.EVENT_READ, "in")
selector.register(server, selectors.EVENT_READ, "server")


def write_all(fd, data):
    view = memoryview(data)
    while view:
        written = os.write(fd, view)
        view = view[written:]


while True:
    for key, _ in selector.select():
        if key.data == "in":
            data = os.read(stdin, 65536)
            if not data:
                sys.exit(0)
            server.sendall(data)
        else:
            data = server.recv(65536)
            if not data:
                sys.exit(0)
            write_all(stdout, data)
