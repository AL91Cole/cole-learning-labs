#!/bin/sh
# Keeps windows on the screen when the screen gets smaller. The desktop follows
# the size of the learner's browser window, and the window manager leaves
# windows where they were, so after a shrink a window could reach under the
# taskbar or past the right edge. This moves such a window back into view, and
# makes it smaller only if it no longer fits, as full desktops do when the
# resolution changes. Started with the session (/etc/xdg/autostart).

# The usable area (the screen less the taskbar): "X Y WIDTH HEIGHT".
workarea() { xprop -root _NET_WORKAREA 2>/dev/null | sed -n 's/.*= *\([0-9]*\), *\([0-9]*\), *\([0-9]*\), *\([0-9]*\).*/\1 \2 \3 \4/p'; }
# Where a window's contents are on the screen, and their size: "X Y WIDTH HEIGHT".
geometry() { xwininfo -id "$1" 2>/dev/null | sed -n 's/.*Absolute upper-left X: *\(-*[0-9]*\).*/\1/p; s/.*Absolute upper-left Y: *\(-*[0-9]*\).*/\1/p; s/^ *Width: *\([0-9]*\).*/\1/p; s/^ *Height: *\([0-9]*\).*/\1/p' | tr '\n' ' '; }
# Moves a window's contents to X Y. The window manager adds its own offset to a
# move request, so the request is corrected once by what actually happened.
place() {
  xdotool windowmove "$1" "$2" "$3" 2>/dev/null; sleep 0.2
  set -- "$1" "$2" "$3" $(geometry "$1")
  [ $# -eq 7 ] && xdotool windowmove "$1" $(($2 + $2 - $4)) $(($3 + $3 - $5)) 2>/dev/null
}

fit_windows() {
  set -- $(workarea)
  [ $# -eq 4 ] || return 0
  ax=$1; ay=$2; aw=$3; ah=$4
  for id in $(xprop -root _NET_CLIENT_LIST 2>/dev/null | sed -n 's/.*# //p' | tr -d ','); do
    # Ordinary windows and dialogs only; maximized and full-screen ones follow the screen already.
    xprop -id "$id" _NET_WM_WINDOW_TYPE 2>/dev/null | grep -Eq '_NET_WM_WINDOW_TYPE_(NORMAL|DIALOG)' || continue
    xprop -id "$id" _NET_WM_STATE 2>/dev/null | grep -Eq 'MAXIMIZED|FULLSCREEN|HIDDEN' && continue
    set -- $(geometry "$id")
    [ $# -eq 4 ] || continue
    x=$1; y=$2; w=$3; h=$4
    # The frame around the window: left, right, top (title bar) and bottom borders.
    set -- $(xprop -id "$id" _NET_FRAME_EXTENTS 2>/dev/null | sed -n 's/.*= *//p' | tr -d ',')
    fl=${1:-0}; fr=${2:-0}; ft=${3:-0}; fb=${4:-0}
    # Too large for the area: make it smaller (never below a usable size).
    maxw=$((aw - fl - fr)); maxh=$((ah - ft - fb))
    nw=$w; nh=$h
    [ "$w" -gt "$maxw" ] && [ "$maxw" -ge 200 ] && nw=$maxw
    [ "$h" -gt "$maxh" ] && [ "$maxh" -ge 120 ] && nh=$maxh
    if [ "$nw" != "$w" ] || [ "$nh" != "$h" ]; then
      xdotool windowsize "$id" "$nw" "$nh" 2>/dev/null; sleep 0.2
      set -- $(geometry "$id"); [ $# -eq 4 ] && { w=$3; h=$4; }
    fi
    # Past the right or bottom edge: move back inside, keeping the title bar visible.
    nx=$x; ny=$y
    [ $((x + w + fr)) -gt $((ax + aw)) ] && nx=$((ax + aw - w - fr))
    [ $((y + h + fb)) -gt $((ay + ah)) ] && ny=$((ay + ah - h - fb))
    [ "$nx" -lt $((ax + fl)) ] && nx=$((ax + fl))
    [ "$ny" -lt $((ay + ft)) ] && ny=$((ay + ft))
    if [ "$nx" != "$x" ] || [ "$ny" != "$y" ]; then place "$id" "$nx" "$ny"; fi
  done
}

last=""
while :; do
  size=$(workarea)
  if [ -n "$size" ] && [ "$size" != "$last" ]; then
    [ -n "$last" ] && sleep 0.5 && fit_windows
    last=$size
  fi
  sleep 1
done
