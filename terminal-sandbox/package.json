{
  "name": "cole-learning-labs-terminal-sandbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chromebook-compatible xterm.js + Docker Alpine sandbox backend over Cloudflare Port 443 WebSockets for Cole Learning Labs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "docker:build-sandbox": "docker build -f Dockerfile.sandbox -t cole-learning-labs/sandbox:alpine .",
    "test": "node --test ../tests/terminal-sandbox.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "google-auth-library": "^9.15.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
