# Copy to deploy/.env.production on the server (chmod 600); never commit the populated file.
# Used by: docker compose --env-file deploy/.env.production -f deploy/docker-compose.cloud.yml up -d --build

# Docker account that owns the learner machines. The token needs
# "Allow Cloud Sandboxes access". Create it at hub.docker.com > Account settings >
# Personal access tokens. Revoke any token that was ever pasted into a chat.
DOCKER_ID=
DOCKER_PAT=

# Learner machine size: micro (1 CPU, 2 GiB, about $0.07/h) is enough for every lab.
SANDBOX_SIZE=micro
# Public image the controller seeds at start; change only for a custom image.
SANDBOX_IMAGE_REF=docker.io/library/python:3.13-alpine

# Browser origins allowed to open a machine (the public site).
ALLOWED_ORIGINS=https://your-site.example

# Random secret of at least 32 characters for the teacher view, shared out of band:
#   openssl rand -hex 32
TEACHER_ACCESS_KEY=

# Cloudflare Tunnel connector token from Zero Trust > Networks > Tunnels
# (the tunnel's public hostname is terminal.your-site.example -> http://orchestrator:8080).
TUNNEL_TOKEN=

# Upgrades per minute from the tunnel connector, the only peer the controller sees.
MAX_UPGRADES_PER_PEER_MINUTE=240
