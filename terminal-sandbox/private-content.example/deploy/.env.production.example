# Copy to deploy/.env.production on the server; never commit the populated file.
SANDBOX_ENABLED=true
HOST=127.0.0.1
PORT=8080
SANDBOX_IMAGE=cole-learning-labs/sandbox:private
LAB_CONTENT_MODULE=/content/labs/index.js
# The public site origin that embeds the real machine (same-origin route /terminal/* recommended).
ALLOWED_ORIGINS=https://your-site.example
# Random secret of at least 32 characters, shared with teachers out of band.
TEACHER_ACCESS_KEY=
# Exact reverse-proxy or tunnel peer addresses.
TRUSTED_PROXY_ADDRESSES=
MAX_UPGRADES_PER_PEER_MINUTE=120
ALLOW_INSECURE_LOCALHOST=false
DOCKER_SOCKET_GID=
# Learner machine backend: docker (containers on this host) or cloud (Docker Cloud Sandboxes).
SANDBOX_BACKEND=docker
# Cloud backend only; the token is a secret, set it from the host's secret store.
DOCKER_ID=
DOCKER_PAT=
SANDBOX_IMAGE_REF=
SANDBOX_SIZE=micro
