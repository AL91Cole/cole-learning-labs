# Separate prototype service. Explicit school/privacy and deployment review is required.
SANDBOX_ENABLED=false
HOST=127.0.0.1
PORT=8080
SANDBOX_IMAGE=cole-learning-labs/sandbox:alpine
# Where learner machines run. "docker": containers on this host through the Docker
# socket (default). "cloud": one Docker Cloud Sandbox per learner through Docker's
# Sandboxes API; no Docker daemon on this host, the controller only needs HTTPS.
SANDBOX_BACKEND=docker
# Cloud backend only. The personal access token needs "Allow Cloud Sandboxes access";
# keep it in the deployment's secret store, never in a committed file or a URL.
DOCKER_ID=
DOCKER_PAT=
# Cloud backend only: the lab image pushed to a registry Docker can pull from,
# for example docker.io/<account>/cll-sandbox:cloud (a private Docker Hub repository works).
SANDBOX_IMAGE_REF=
# Cloud backend only: micro (1 CPU, 2 GiB), small (2, 4), medium (4, 8), large (8, 16), xl (16, 32).
SANDBOX_SIZE=micro
ALLOWED_ORIGINS=https://terminal.your-site.example
# Generate a random secret (at least32characters), distribute out of band to teachers.
# Never commit the populated .env file or expose this key in URLs/logs/frontend assets.
TEACHER_ACCESS_KEY=
# Exact reverse-proxy peer IPs only. Untrusted forwarded-proto/Cloudflare headers grant nothing.
TRUSTED_PROXY_ADDRESSES=
# Shared by all browsers behind one ingress peer. Not a per-student identity.
# Default 120 upgrades/minute supports the 24-learner pilot plus reconnects.
MAX_UPGRADES_PER_PEER_MINUTE=120
# Loopback development only. Leave false for any deployment.
ALLOW_INSECURE_LOCALHOST=false
# Docker Compose: inspect and supply the Docker socket's group ID.
DOCKER_SOCKET_GID=
# Optional private lab content: an absolute path to a module exporting `labs`.
# Keep paid lab definitions, seed files and deployment settings in the private repository.
LAB_CONTENT_MODULE=
