# Separate prototype service. Explicit school/privacy and deployment review is required.
SANDBOX_ENABLED=false
HOST=127.0.0.1
PORT=8080
SANDBOX_IMAGE=cole-learning-labs/sandbox:alpine
# Where learner machines run. "docker": containers on this host through the Docker
# socket (default). "cloud": one Docker Cloud Sandbox per learner through Docker's
# Sandboxes API; no Docker daemon on this host, the controller only needs HTTPS.
SANDBOX_BACKEND=docker
# Cloud backend only. The personal access token needs "Allow Cloud Sandboxes access";
# keep it in the deployment's secret store, never in a committed file or a URL.
DOCKER_ID=
DOCKER_PAT=
# Cloud backend only: the public image each learner machine starts from. The
# controller creates the learner user and writes the lab files itself, so the
# default python:3.13-alpine needs nothing pushed to a registry. A custom image
# works too if it is public on Docker Hub (docker.io or dhi.io: Docker Cloud refuses
# every other registry, ghcr.io included); set SANDBOX_START_COMMAND if it needs its
# entrypoint.
SANDBOX_IMAGE_REF=docker.io/library/python:3.13-alpine
# Cloud backend only: colon-separated directories copied into /home/learner/lab
# at start. Default: the public sample seed (sandbox-seed/). Add the private
# repository's seed directory for paid labs, for example
# SANDBOX_SEED_DIRS=/app/sandbox-seed:/content/sandbox/seed
SANDBOX_SEED_DIRS=
# Cloud backend only: micro (1 CPU, 2 GiB), small (2, 4), medium (4, 8), large (8, 16), xl (16, 32).
SANDBOX_SIZE=micro
# Cloud backend: "desktop" (default) is a graphical Linux desktop streamed to the
# learner's browser through this controller; "terminal" is a shell only.
# Host-container backend: "terminal" is the default; "desktop" starts desktops from
# DESKTOP_IMAGE (build it from desktop/Dockerfile) on this host.
SANDBOX_VIEW=desktop
# Host-container backend with SANDBOX_VIEW=desktop: the local desktop image.
DESKTOP_IMAGE=cole-learning-labs/desktop:noble
# Desktop view: the public desktop image, its machine size, and the screen size
# used when the browser does not report the size of its lab area. The project's
# own image (desktop/Dockerfile, published by .github/workflows/desktop-image.yml)
# is the maintained replacement for the default; use its versioned Docker Hub tag,
# for example DESKTOP_IMAGE_REF=docker.io/al91cole/cole-learning-labs-desktop:noble-<commit>
# Docker Cloud Sandboxes refuse images from other registries (ghcr.io included).
DESKTOP_IMAGE_REF=docker.io/dorowu/ubuntu-desktop-lxde-vnc:focal
DESKTOP_SIZE=small
DESKTOP_RESOLUTION=1024x768
ALLOWED_ORIGINS=https://terminal.your-site.example
# Generate a random secret (at least32characters), distribute out of band to teachers.
# Never commit the populated .env file or expose this key in URLs/logs/frontend assets.
TEACHER_ACCESS_KEY=
# Exact reverse-proxy peer IPs only. Untrusted forwarded-proto/Cloudflare headers grant nothing.
TRUSTED_PROXY_ADDRESSES=
# Shared by all browsers behind one ingress peer. Not a per-student identity.
# Default 120 upgrades/minute supports the 24-learner pilot plus reconnects.
MAX_UPGRADES_PER_PEER_MINUTE=120
# Loopback development only. Leave false for any deployment.
ALLOW_INSECURE_LOCALHOST=false
# Docker Compose: inspect and supply the Docker socket's group ID.
DOCKER_SOCKET_GID=
# Optional private lab content: an absolute path to a module exporting `labs`.
# Keep paid lab definitions, seed files and deployment settings in the private repository.
LAB_CONTENT_MODULE=
