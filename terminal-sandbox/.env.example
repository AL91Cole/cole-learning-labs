# Separate prototype service. Explicit school/privacy and deployment review is required.
SANDBOX_ENABLED=false
HOST=127.0.0.1
PORT=8080
SANDBOX_IMAGE=cole-learning-labs/sandbox:alpine
ALLOWED_ORIGINS=https://terminal.colelearninglabs.com
# Generate a random secret (at least32characters), distribute out of band to teachers.
# Never commit the populated .env file or expose this key in URLs/logs/frontend assets.
TEACHER_ACCESS_KEY=
# Exact reverse-proxy peer IPs only. Untrusted forwarded-proto/Cloudflare headers grant nothing.
TRUSTED_PROXY_ADDRESSES=
# Shared by all browsers behind one ingress peer. Not a per-student identity.
# Default 120 upgrades/minute supports the 24-learner pilot plus reconnects.
MAX_UPGRADES_PER_PEER_MINUTE=120
# Loopback development only. Leave false for any deployment.
ALLOW_INSECURE_LOCALHOST=false
# Docker Compose: inspect and supply the Docker socket's group ID.
DOCKER_SOCKET_GID=
